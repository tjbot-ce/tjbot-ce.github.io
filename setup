#!/usr/bin/env bash
set -euo pipefail

script_url="https://raw.githubusercontent.com/tjbot-ce/tjbot/refs/heads/main/bin/tjbot_setup"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
	echo "This installer must run as root."
	echo "Run: curl -sL https://tjbot-ce.github.io/setup | sudo bash"
	exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
	echo "curl is required but was not found."
	exit 1
fi

tmp_script="$(mktemp -t tjbot_setup.XXXXXX)"
cleanup() {
	rm -f "$tmp_script"
}
trap cleanup EXIT

curl -fSL "$script_url" -o "$tmp_script"
chmod 700 "$tmp_script"

bash "$tmp_script" "$@"
